{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {telemetry, "1.3.0"},
    {kura, {git, "https://github.com/Taure/kura.git", {tag, "v2.0.6"}}}
]}.

{project_plugins, [
    erlfmt,
    rebar3_ex_doc,
    rebar3_lint,
    rebar3_hank,
    {rebar3_kura, "0.13.1"},
    {rebar3_audit, {git, "https://github.com/Taure/rebar3_audit.git", {branch, "main"}}},
    {rebar3_sbom,
        {git, "https://github.com/Taure/rebar3_sbom.git", {branch, "feat/include-otp-components"}}},
    covertool
]}.

{provider_hooks, [
    {pre, [{compile, {kura, compile}}]}
]}.

{overrides, [
    {override, kura, [{erl_opts, [debug_info]}]}
]}.

{hex, [{doc, ex_doc}]}.

{erlfmt, [write]}.

{hank, [
    {ignore, [
        "test/**",
        {"src/gakudan_agent.erl", [unused_callbacks]},
        {"src/gakudan_router.erl", [unused_callbacks]}
    ]}
]}.

{dialyzer, [
    {warnings, [error_handling, unmatched_returns, unknown]},
    {plt_apps, all_deps}
]}.

{xref_checks, [undefined_function_calls, undefined_functions]}.

{ct_opts, [{dir, "test"}]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]},
        %% Real Postgres backend for the kura durability suite
        %% (gakudan_kura_SUITE) - the same stack a production host runs:
        %% gakudan + kura + kura_postgres. gakudan core stays driver-agnostic;
        %% only the integration tests pull the backend.
        {deps, [
            {kura_postgres, {git, "https://github.com/Taure/kura_postgres.git", {branch, "main"}}}
        ]}
    ]},
    {example, [
        {erl_opts, [debug_info, nowarn_export_all]},
        {src_dirs, ["src", "examples/planner_coder/src", "examples/debate/src"]}
    ]}
]}.

{cover_enabled, true}.

{ex_doc, [
    {extras, [
        <<"README.md">>,
        <<"docs/getting-started.md">>,
        <<"docs/architecture.md">>,
        <<"docs/adr/0001-telemetry-events.md">>,
        <<"docs/adr/0002-eval-harness.md">>,
        <<"docs/adr/0003-checkpointer-behaviour.md">>,
        <<"docs/adr/0004-resume-interrupt-idempotency.md">>,
        <<"docs/adr/0005-streaming.md">>,
        <<"docs/adr/0006-mcp-client.md">>,
        <<"docs/adr/0007-parallel-agent-execution.md">>,
        <<"docs/adr/0008-opentelemetry-spans.md">>,
        <<"docs/adr/0009-tool-idempotency-supervised-resume.md">>,
        <<"docs/adr/0010-guardrails.md">>,
        <<"docs/adr/0011-cloud-provider-backends.md">>,
        <<"docs/adr/0012-audit-logging.md">>,
        <<"docs/adr/0013-cost-budgets.md">>,
        <<"docs/adr/0014-streaming-cancellation-backpressure.md">>,
        <<"docs/adr/0015-mcp-oauth.md">>
    ]},
    {main, <<"readme">>},
    {proglang, erlang},
    {source_url, <<"https://github.com/Taure/gakudan">>}
]}.
