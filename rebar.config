{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {telemetry, "~> 1.3"},
    {kura, "~> 2.20"}
]}.

{project_plugins, [
    erlfmt,
    rebar3_ex_doc,
    rebar3_lint,
    rebar3_hank,
    {rebar3_kura, "~> 0.15"},
    {rebar3_mutate, "~> 0.5"},
    {rebar3_audit, "~> 0.2"},
    %% Taure fork, not the hex package: hex ships voltone/rebar3_sbom, which
    %% lacks the OTP-components work this branch carries (7 commits ahead, no
    %% tag of its own - the fork's tags mirror upstream). Pinned to the commit
    %% rather than the branch so it cannot move underneath a build.
    {rebar3_sbom,
        {git, "https://github.com/Taure/rebar3_sbom.git",
            {ref, "a2d37609afb43e371e074d3e0b64d3baec67398e"}}},
    covertool
]}.

{overrides, [
    {override, kura, [{erl_opts, [debug_info]}]}
]}.

{hex, [{doc, ex_doc}]}.

{erlfmt, [write]}.

{hank, [
    {ignore, [
        "test/**",
        {"src/gakudan_agent.erl", [unused_callbacks]},
        {"src/gakudan_router.erl", [unused_callbacks]}
    ]}
]}.

{dialyzer, [
    {warnings, [error_handling, unmatched_returns, unknown]},
    {plt_apps, all_deps}
]}.

{xref_checks, [undefined_function_calls, undefined_functions]}.

{ct_opts, [{dir, "test"}]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]},
        %% Migration generation is a DEVELOPMENT step, not a build step. It must
        %% not sit at the top level: provider_hooks propagate to consumers, and
        %% the `kura compile` provider only exists if the consumer adds
        %% rebar3_kura to their own project_plugins - so a fresh consumer's
        %% build aborted with {badrecord,not_found}, naming neither.
        {provider_hooks, [{pre, [{compile, {kura, compile}}]}]},
        %% Real Postgres backend for the kura durability suite
        %% (gakudan_kura_SUITE) - the same stack a production host runs:
        %% gakudan + kura + kura_postgres. gakudan core stays driver-agnostic;
        %% only the integration tests pull the backend.
        {deps, [
            {kura_postgres, "~> 1.1"}
        ]}
    ]},
    {example, [
        {erl_opts, [debug_info, nowarn_export_all]},
        {src_dirs, ["src", "examples/planner_coder/src", "examples/debate/src"]}
    ]}
]}.

{cover_enabled, true}.

{ex_doc, [
    {extras, [
        <<"README.md">>,
        <<"docs/getting-started.md">>,
        <<"docs/architecture.md">>,
        <<"docs/adr/0001-telemetry-events.md">>,
        <<"docs/adr/0002-eval-harness.md">>,
        <<"docs/adr/0003-checkpointer-behaviour.md">>,
        <<"docs/adr/0004-resume-interrupt-idempotency.md">>,
        <<"docs/adr/0005-streaming.md">>,
        <<"docs/adr/0006-mcp-client.md">>,
        <<"docs/adr/0007-parallel-agent-execution.md">>,
        <<"docs/adr/0008-opentelemetry-spans.md">>,
        <<"docs/adr/0009-tool-idempotency-supervised-resume.md">>,
        <<"docs/adr/0010-guardrails.md">>,
        <<"docs/adr/0011-cloud-provider-backends.md">>,
        <<"docs/adr/0012-audit-logging.md">>,
        <<"docs/adr/0013-cost-budgets.md">>,
        <<"docs/adr/0014-streaming-cancellation-backpressure.md">>,
        <<"docs/adr/0015-mcp-oauth.md">>,
        <<"docs/adr/0016-llm-request-options.md">>,
        <<"docs/adr/0017-structured-output-validation.md">>,
        <<"docs/adr/0018-resilient-llm-backends.md">>,
        <<"docs/adr/0019-context-compaction.md">>,
        <<"docs/adr/0020-parallel-tool-calls.md">>,
        <<"docs/adr/0021-fork-from-checkpoint.md">>,
        <<"docs/adr/0022-loop-and-auto-routers.md">>
    ]},
    {main, <<"readme">>},
    {proglang, erlang},
    {source_url, <<"https://github.com/Taure/gakudan">>}
]}.
